{
  "manifest_version": 3,
  "name": "Deriv Analyzer — Investigación multiactivo",
  "version": "2.0.0",
  "description": "Escáner experimental de velas e indicadores de Deriv. No ejecuta operaciones.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://dtrader.deriv.com/*",
    "https://*.deriv.com/*"
  ],
  "action": {
    "default_title": "Abrir Deriv Analyzer"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "116"
}
